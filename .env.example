# Open Notebook Configuration
# Copy this file to .env and customize as needed
#
# Generate strong random values for the REQUIRED secrets, e.g. on Linux/macOS:
#   openssl rand -hex 32
# or with Python:
#   python -c "import secrets; print(secrets.token_hex(32))"

# =============================================================================
# REQUIRED (docker-compose.yml will refuse to start without these)
# =============================================================================

# Encryption key for storing API credentials securely in the database.
# Use a strong random string (minimum 32 characters recommended). MUST be set
# before first run and MUST NOT be changed afterward (encrypted values would
# become unreadable). Compose fails fast if this is missing.
OPEN_NOTEBOOK_ENCRYPTION_KEY=

# JWT signing key for multi-user auth sessions. Generate a strong random
# string (minimum 32 characters). Rotating it invalidates all active sessions.
JWT_SECRET_KEY=

# =============================================================================
# DATABASE (Default values work with docker-compose.yml)
# =============================================================================

SURREAL_URL=ws://surrealdb:8000/rpc
# root:root is fine for local use. Change these before exposing the instance to a
# network — docker-compose.yml reads them for both the SurrealDB server and the
# app, so the two stay in sync.
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=open_notebook

# =============================================================================
# OPTIONAL: AI Provider API Keys
# =============================================================================
# You can configure these via the UI (Settings → API Keys) or set them here
# UI configuration is recommended for better security and flexibility

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google AI
# GOOGLE_API_KEY=...

# Groq
# GROQ_API_KEY=gsk_...

# =============================================================================
# OPTIONAL: Advanced Configuration
# =============================================================================

# External API URL (for webhooks, callbacks, etc.)
# API_URL=http://localhost:5055

# Ollama endpoint (if running locally)
# OLLAMA_BASE_URL=http://ollama:11434

# Ollama Cloud (remote Ollama endpoint, e.g. Ollama Cloud / Runpod)
# OLLAMA_CLOUD_BASE_URL=https://your-cloud-host:11434
# OLLAMA_CLOUD_API_KEY=your-cloud-api-key

# SSH access into the Open Notebook container (optional)
# The container runs sshd on port 2222 alongside the web GUI.
# SSH_USER=notebook
# SSH_PASSWORD=notebook
# SSH_PORT=2222
# For key-based auth, mount your pubkey at /app/ssh/authorized_keys

# Content processing
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=150

# Security
# BASIC_AUTH_USERNAME=admin
# BASIC_AUTH_PASSWORD=secret

# For more configuration options, see:
# https://github.com/lfnovo/open-notebook/blob/main/docs/5-CONFIGURATION/environment-reference.md

# =============================================================================
# VPS DEPLOYMENT (Phase 2)
# =============================================================================
# On a VPS, set at least these in your .env before running scripts/deploy-vps.sh:
#   OPEN_NOTEBOOK_ENCRYPTION_KEY   (strong random, 32+ chars)
#   JWT_SECRET_KEY                  (strong random, 32+ chars)
#   SURREAL_USER / SURREAL_PASSWORD (change from root:root)
#   SSH_PASSWORD                    (change from "notebook")
#   OLLAMA_API_BASE                 (e.g. http://10.x.x.x:11434 — the host's
#                                    LAN/VPN IP; host.docker.internal only works
#                                    on Docker Desktop, not Linux hosts)
# The reverse proxy (Phase 2) fronts the app at brain.itak.live.
