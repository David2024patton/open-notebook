-- Migration 23: Native SurrealDB multi-tenancy via SCOPE + record-level PERMISSIONS
--
-- Enforces tenant isolation at the database root instead of relying solely on
-- application code. Authenticated request sessions sign in through the
-- `user_scope` JWT scope (defined dynamically at app startup with the live
-- signing secret), which populates $auth.id (the user record id) and
-- $auth.role. Every tenant-owned table is then gated by record permissions:
--
--   select -> owner = $auth.id OR is_global = true OR $auth.role IN [admin, superuser]
--   create -> $auth.id IS NOT NONE            (scope session must be present)
--   update -> owner = $auth.id OR $auth.role IN [admin, superuser]
--   delete -> owner = $auth.id OR $auth.role IN [admin, superuser]
--
-- The `user`, `referral_code`, `signup_request` tables are management tables
-- gated to admins/superusers (users may read their own row). `notification`
-- and `user_totp` are strictly private (keyed by for_user / user_id).
--
-- Owner stamping: performed by the application bridge (repository.stamp_owner,
-- populated from the per-request contextvar) — NOT by a field DEFAULT, because
-- $auth is not available inside field VALUE/DEFAULT clauses in SurrealDB.
--
-- Root (migrations, health, internal jobs) bypasses these permissions, so the
-- backfill below and all startup work run unimpeded.
--
-- IMPORTANT: the `user_scope` itself is defined at runtime in api/main.py
-- (DEFINE SCOPE ... TYPE JWT ... KEY <live secret>) because the HMAC key is an
-- environment secret and must not be committed to this file.

-- ===========================================================================
-- 1. Ensure tenant tables exist (no-op on an already-migrated database) and
--    add the is_global flag + owner field. Permissions are applied in step 2.
-- ===========================================================================
DEFINE TABLE IF NOT EXISTS notebook SCHEMAFULL;
DEFINE TABLE IF NOT EXISTS source SCHEMAFULL;
DEFINE TABLE IF NOT EXISTS note SCHEMAFULL;
DEFINE TABLE IF NOT EXISTS source_embedding SCHEMAFULL;
DEFINE TABLE IF NOT EXISTS source_insight SCHEMAFULL;
DEFINE TABLE IF NOT EXISTS chat_session SCHEMAFULL;
DEFINE TABLE IF NOT EXISTS notification SCHEMAFULL;
DEFINE TABLE IF NOT EXISTS user_totp SCHEMAFULL;
DEFINE TABLE IF NOT EXISTS user SCHEMAFULL;
DEFINE TABLE IF NOT EXISTS referral_code SCHEMAFULL;
DEFINE TABLE IF NOT EXISTS signup_request SCHEMAFULL;

-- is_global flag on the core knowledge tables (Brain Cells can be shared)
DEFINE FIELD IF NOT EXISTS is_global ON notebook TYPE bool VALUE $value OR false;
DEFINE FIELD IF NOT EXISTS is_global ON source TYPE bool VALUE $value OR false;
DEFINE FIELD IF NOT EXISTS is_global ON note TYPE bool VALUE $value OR false;
DEFINE FIELD IF NOT EXISTS is_global ON source_embedding TYPE bool VALUE $value OR false;
DEFINE FIELD IF NOT EXISTS is_global ON source_insight TYPE bool VALUE $value OR false;
DEFINE FIELD IF NOT EXISTS is_global ON chat_session TYPE bool VALUE $value OR false;

-- owner field on all tenant tables (notebook.owner was added in migration 18).
-- No VALUE default: owner is stamped by the app bridge at create time.
DEFINE FIELD IF NOT EXISTS owner ON notebook TYPE option<record<user>>;
DEFINE FIELD IF NOT EXISTS owner ON source TYPE option<record<user>>;
DEFINE FIELD IF NOT EXISTS owner ON note TYPE option<record<user>>;
DEFINE FIELD IF NOT EXISTS owner ON source_embedding TYPE option<record<user>>;
DEFINE FIELD IF NOT EXISTS owner ON source_insight TYPE option<record<user>>;
DEFINE FIELD IF NOT EXISTS owner ON chat_session TYPE option<record<user>>;

-- ===========================================================================
-- 2. Apply record-level permissions. The table already exists, so this
--    DEFINE TABLE (without IF NOT EXISTS) sets PERMISSIONS on it.
-- ===========================================================================

DEFINE TABLE notebook SCHEMAFULL
PERMISSIONS
  FOR select WHERE owner = $auth.id OR is_global = true OR $auth.role IN ['admin', 'superuser']
  FOR create, update, delete WHERE owner = $auth.id OR $auth.role IN ['admin', 'superuser'];

DEFINE TABLE source SCHEMAFULL
PERMISSIONS
  FOR select WHERE owner = $auth.id OR is_global = true OR $auth.role IN ['admin', 'superuser']
  FOR create, update, delete WHERE owner = $auth.id OR $auth.role IN ['admin', 'superuser'];

DEFINE TABLE note SCHEMAFULL
PERMISSIONS
  FOR select WHERE owner = $auth.id OR is_global = true OR $auth.role IN ['admin', 'superuser']
  FOR create, update, delete WHERE owner = $auth.id OR $auth.role IN ['admin', 'superuser'];

DEFINE TABLE source_embedding SCHEMAFULL
PERMISSIONS
  FOR select WHERE owner = $auth.id OR is_global = true OR $auth.role IN ['admin', 'superuser']
  FOR create, update, delete WHERE owner = $auth.id OR $auth.role IN ['admin', 'superuser'];

DEFINE TABLE source_insight SCHEMAFULL
PERMISSIONS
  FOR select WHERE owner = $auth.id OR is_global = true OR $auth.role IN ['admin', 'superuser']
  FOR create, update, delete WHERE owner = $auth.id OR $auth.role IN ['admin', 'superuser'];

DEFINE TABLE chat_session SCHEMAFULL
PERMISSIONS
  FOR select WHERE owner = $auth.id OR is_global = true OR $auth.role IN ['admin', 'superuser']
  FOR create, update, delete WHERE owner = $auth.id OR $auth.role IN ['admin', 'superuser'];

-- Strictly private tables (never shared, no admin cross-access)
DEFINE TABLE notification SCHEMAFULL
PERMISSIONS
  FOR select, create, update, delete WHERE for_user = $auth.id;

DEFINE TABLE user_totp SCHEMAFULL
PERMISSIONS
  FOR select, create, update, delete WHERE user_id = $auth.id;

-- Management tables (admin/superuser operated; users read their own row)
DEFINE TABLE user SCHEMAFULL
PERMISSIONS
  FOR select WHERE id = $auth.id OR $auth.role IN ['admin', 'superuser']
  FOR create, update, delete WHERE $auth.role IN ['admin', 'superuser'];

DEFINE TABLE referral_code SCHEMAFULL
PERMISSIONS
  FOR select WHERE created_by = $auth.id OR $auth.role IN ['admin', 'superuser']
  FOR create, update, delete WHERE $auth.role IN ['admin', 'superuser'];

DEFINE TABLE signup_request SCHEMAFULL
PERMISSIONS
  FOR select WHERE username = $auth.username OR $auth.role IN ['admin', 'superuser']
  FOR create WHERE $auth.id IS NOT NONE
  FOR update, delete WHERE $auth.role IN ['admin', 'superuser'];

-- ===========================================================================
-- 3. One-time backfill (intentionally omitted from this migration).
--    On a fresh database there are no pre-multi-tenancy records to reassign,
--    and the first registered user is auto-promoted to superuser by the
--    application (see api/routers/auth.py register). If orphaned tenant
--    records ever need reassignment to a superuser, do it via a dedicated
--    admin script rather than a startup migration, to avoid SURREALQL
--    control-flow (IF/LET) parse pitfalls during automated migration runs.
-- ===========================================================================
