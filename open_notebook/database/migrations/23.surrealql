-- Migration 23: Native SurrealDB multi-tenancy via SCOPE + record-level PERMISSIONS
--
-- Enforces tenant isolation at the database root instead of relying solely on
-- application code. Authenticated request sessions sign in through the
-- `user_scope` JWT scope (defined dynamically at app startup with the live
-- signing secret), which populates $auth.id (the user record id) and
-- $auth.role. Every tenant-owned table is then gated by record permissions:
--
--   select -> owner = $auth.id OR is_global = true OR $auth.role IN [admin, superuser]
--   create -> $auth.id IS NOT NONE            (scope session must be present)
--   update -> owner = $auth.id OR $auth.role IN [admin, superuser]
--   delete -> owner = $auth.id OR $auth.role IN [admin, superuser]
--
-- The `user`, `referral_code`, `signup_request` tables are management tables
-- gated to admins/superusers (users may read their own row). `notification`
-- and `user_totp` are strictly private (keyed by for_user / user_id).
--
-- Root (migrations, health, internal jobs) bypasses these permissions, so the
-- backfill below and all startup work run unimpeded.
--
-- IMPORTANT: the `user_scope` itself is defined at runtime in api/main.py
-- (DEFINE SCOPE ... TYPE JWT ... KEY <live secret>) because the HMAC key is an
-- environment secret and must not be committed to this file.

-- ===========================================================================
-- 1. is_global flag on the core knowledge tables (Brain Cells can be shared)
-- ===========================================================================
DEFINE FIELD IF NOT EXISTS is_global ON notebook TYPE bool VALUE $value OR false;
DEFINE FIELD IF NOT EXISTS is_global ON source TYPE bool VALUE $value OR false;
DEFINE FIELD IF NOT EXISTS is_global ON note TYPE bool VALUE $value OR false;
DEFINE FIELD IF NOT EXISTS is_global ON source_embedding TYPE bool VALUE $value OR false;
DEFINE FIELD IF NOT EXISTS is_global ON source_insight TYPE bool VALUE $value OR false;
DEFINE FIELD IF NOT EXISTS is_global ON chat_session TYPE bool VALUE $value OR false;

-- ===========================================================================
-- 2. owner field on child tables (notebook.owner already added in migration 18)
--    VALUE $value OR $auth.id auto-stamps the scope identity on create
--    (defense-in-depth; the app also stamps owner explicitly via the bridge).
-- ===========================================================================
DEFINE FIELD IF NOT EXISTS owner ON notebook TYPE option<record<user>> VALUE $value OR $auth.id;
DEFINE FIELD IF NOT EXISTS owner ON source TYPE option<record<user>> VALUE $value OR $auth.id;
DEFINE FIELD IF NOT EXISTS owner ON note TYPE option<record<user>> VALUE $value OR $auth.id;
DEFINE FIELD IF NOT EXISTS owner ON source_embedding TYPE option<record<user>> VALUE $value OR $auth.id;
DEFINE FIELD IF NOT EXISTS owner ON source_insight TYPE option<record<user>> VALUE $value OR $auth.id;
DEFINE FIELD IF NOT EXISTS owner ON chat_session TYPE option<record<user>> VALUE $value OR $auth.id;

-- ===========================================================================
-- 3. Record-level permissions on tenant-owned tables
-- ===========================================================================

DEFINE TABLE IF NOT EXISTS notebook SCHEMAFULL
  PERMISSIONS FOR
    select WHERE owner = $auth.id OR is_global = true OR $auth.role IN ['admin', 'superuser']
    create WHERE $auth.id IS NOT NONE
    update WHERE owner = $auth.id OR $auth.role IN ['admin', 'superuser']
    delete WHERE owner = $auth.id OR $auth.role IN ['admin', 'superuser'];

DEFINE TABLE IF NOT EXISTS source SCHEMAFULL
  PERMISSIONS FOR
    select WHERE owner = $auth.id OR is_global = true OR $auth.role IN ['admin', 'superuser']
    create WHERE $auth.id IS NOT NONE
    update WHERE owner = $auth.id OR $auth.role IN ['admin', 'superuser']
    delete WHERE owner = $auth.id OR $auth.role IN ['admin', 'superuser'];

DEFINE TABLE IF NOT EXISTS note SCHEMAFULL
  PERMISSIONS FOR
    select WHERE owner = $auth.id OR is_global = true OR $auth.role IN ['admin', 'superuser']
    create WHERE $auth.id IS NOT NONE
    update WHERE owner = $auth.id OR $auth.role IN ['admin', 'superuser']
    delete WHERE owner = $auth.id OR $auth.role IN ['admin', 'superuser'];

DEFINE TABLE IF NOT EXISTS source_embedding SCHEMAFULL
  PERMISSIONS FOR
    select WHERE owner = $auth.id OR is_global = true OR $auth.role IN ['admin', 'superuser']
    create WHERE $auth.id IS NOT NONE
    update WHERE owner = $auth.id OR $auth.role IN ['admin', 'superuser']
    delete WHERE owner = $auth.id OR $auth.role IN ['admin', 'superuser'];

DEFINE TABLE IF NOT EXISTS source_insight SCHEMAFULL
  PERMISSIONS FOR
    select WHERE owner = $auth.id OR is_global = true OR $auth.role IN ['admin', 'superuser']
    create WHERE $auth.id IS NOT NONE
    update WHERE owner = $auth.id OR $auth.role IN ['admin', 'superuser']
    delete WHERE owner = $auth.id OR $auth.role IN ['admin', 'superuser'];

DEFINE TABLE IF NOT EXISTS chat_session SCHEMAFULL
  PERMISSIONS FOR
    select WHERE owner = $auth.id OR is_global = true OR $auth.role IN ['admin', 'superuser']
    create WHERE $auth.id IS NOT NONE
    update WHERE owner = $auth.id OR $auth.role IN ['admin', 'superuser']
    delete WHERE owner = $auth.id OR $auth.role IN ['admin', 'superuser'];

-- ===========================================================================
-- 4. Strictly private tables (never shared, no admin cross-access)
-- ===========================================================================

DEFINE TABLE IF NOT EXISTS notification SCHEMAFULL
  PERMISSIONS FOR
    select WHERE for_user = $auth.id
    create WHERE $auth.id IS NOT NONE
    update WHERE for_user = $auth.id
    delete WHERE for_user = $auth.id;

DEFINE TABLE IF NOT EXISTS user_totp SCHEMAFULL
  PERMISSIONS FOR
    select WHERE user_id = $auth.id
    create WHERE $auth.id IS NOT NONE
    update WHERE user_id = $auth.id
    delete WHERE user_id = $auth.id;

-- ===========================================================================
-- 5. Management tables (admin/superuser operated; users read their own row)
-- ===========================================================================

DEFINE TABLE IF NOT EXISTS user SCHEMAFULL
  PERMISSIONS FOR
    select WHERE id = $auth.id OR $auth.role IN ['admin', 'superuser']
    create WHERE $auth.role IN ['admin', 'superuser']
    update WHERE id = $auth.id OR $auth.role IN ['admin', 'superuser']
    delete WHERE $auth.role IN ['admin', 'superuser'];

DEFINE TABLE IF NOT EXISTS referral_code SCHEMAFULL
  PERMISSIONS FOR
    select WHERE created_by = $auth.id OR $auth.role IN ['admin', 'superuser']
    create WHERE $auth.role IN ['admin', 'superuser']
    update WHERE $auth.role IN ['admin', 'superuser']
    delete WHERE $auth.role IN ['admin', 'superuser'];

DEFINE TABLE IF NOT EXISTS signup_request SCHEMAFULL
  PERMISSIONS FOR
    select WHERE username = $auth.username OR $auth.role IN ['admin', 'superuser']
    create WHERE $auth.id IS NOT NONE
    update WHERE $auth.role IN ['admin', 'superuser']
    delete WHERE $auth.role IN ['admin', 'superuser'];

-- ===========================================================================
-- 6. One-time backfill: assign orphaned tenant records to the first superuser
--    so pre-multi-tenancy data is not lost behind the new permissions wall.
-- ===========================================================================
LET $superuser = SELECT VALUE id FROM ONLY user WHERE role = 'superuser' ORDER BY created ASC LIMIT 1;

IF $superuser IS NOT NONE THEN
  UPDATE notebook SET owner = $superuser WHERE owner IS NONE;
  UPDATE source SET owner = $superuser WHERE owner IS NONE;
  UPDATE note SET owner = $superuser WHERE owner IS NONE;
  UPDATE source_embedding SET owner = $superuser WHERE owner IS NONE;
  UPDATE source_insight SET owner = $superuser WHERE owner IS NONE;
  UPDATE chat_session SET owner = $superuser WHERE owner IS NONE;
END;
